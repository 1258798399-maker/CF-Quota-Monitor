# Signing config template for CfQuotaMonitor.
# Copy this file to `keystore.properties` (same folder) and fill in your
# real values. `keystore.properties` is gitignored and must NEVER be committed.
#
# Quick start (create your own keystore):
#   keytool -genkey -v -keystore cfquota.keystore -alias cfquota \
#           -keyalg RSA -keysize 2048 -validity 36500 \
#           -storepass <storePassword> -keypass <keyPassword> \
#           -dname "CN=CfQuota,O=Personal,C=US"
#
# Then point `storeFile` at the keystore path (relative to this file's folder).

storeFile=cfquota.keystore
storePassword=your_store_password_here
keyAlias=cfquota
keyPassword=your_key_password_here